---
import BaseLayout from '../layouts/BaseLayout.astro'
import Landing from '../components/Landing.astro'
import { tr } from '../core/i18n/static'
---

<BaseLayout lang="km" title={tr('km', 'landing.title')} description={tr('km', 'landing.description')} alternates={{ km: '/', en: '/en/' }}>
  <script is:inline>
    // Visitor previously chose English: go to the English page.
    try {
      if (localStorage.getItem('kitroid.lang') === 'en') location.replace('/en/')
    } catch (e) {}
  </script>
  <Landing lang="km" />
</BaseLayout>
